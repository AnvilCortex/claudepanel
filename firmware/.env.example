# Copy to .env (gitignored). Baked into the build by env_flags.py.
# With WIFI_PASS left as CHANGE_ME the build falls back to the captive
# portal (AP "ClaudePanel" / password "claudepanel").
WIFI_SSID=YourWiFi
WIFI_PASS=CHANGE_ME
# Host the device dials for its NDJSON/TCP link. IP or DNS name
# (e.g. panel-hub.home.arpa once the hub is deployed).
BRIDGE_HOST=192.168.1.50
BRIDGE_PORT=8788
# Fleet identity, sent in the hello message; the hub routes topics by it.
DEVICE_NAME=desk
