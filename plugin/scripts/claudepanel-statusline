#!/usr/bin/env python3
"""claudepanel: tee Claude Code statusline JSON to the bridge (fail-silent),
then print a minimal statusline. Wire it in settings.json as the statusLine
command, or call it from your own statusline script before rendering.
CLAUDEPANEL_BRIDGE_URL overrides the default bridge endpoint."""
import json
import os
import sys
import urllib.request

raw = sys.stdin.buffer.read()

bridge = os.environ.get("CLAUDEPANEL_BRIDGE_URL", "http://127.0.0.1:8787")
try:
    req = urllib.request.Request(
        bridge + "/statusline",
        data=raw,
        headers={"Content-Type": "application/json"},
    )
    urllib.request.urlopen(req, timeout=1).read()
except Exception:
    pass

try:
    d = json.loads(raw)
    model = (d.get("model") or {}).get("display_name", "")
    cwd = os.path.basename((d.get("workspace") or {}).get("current_dir", "") or "")
    print(" ".join(p for p in (model, cwd) if p))
except Exception:
    print("")
