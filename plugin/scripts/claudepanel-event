#!/usr/bin/env bash
# claudepanel: forward a Claude Code hook event to the local bridge (fail-silent).
# usage: claudepanel-event <EventName>   — hook JSON arrives on stdin
# CLAUDEPANEL_BRIDGE_URL overrides the default bridge endpoint.
bridge="${CLAUDEPANEL_BRIDGE_URL:-http://127.0.0.1:8787}"
input=$(cat)
curl -s -m 1 -X POST "${bridge}/hook/${1:-Unknown}" \
  -H 'Content-Type: application/json' \
  --data-binary "{\"tmux_pane\":\"${TMUX_PANE:-}\",\"hook\":${input:-\{\}}}" \
  >/dev/null 2>&1
exit 0
