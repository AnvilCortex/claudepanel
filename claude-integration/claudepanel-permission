#!/usr/bin/env python3
"""claudepanel: offer a Claude Code permission request on the panel.

Wired as a PermissionRequest hook. Blocks until the bezel answers or the
bridge times out. Silent exit (no output) leaves the normal terminal
permission dialog flow untouched.
"""
import json
import os
import sys
import urllib.request

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

body = json.dumps({
    "session_id": data.get("session_id", ""),
    "tool_name": data.get("tool_name", ""),
    "tool_input": data.get("tool_input") or {},
    "tmux_pane": os.environ.get("TMUX_PANE", ""),
}).encode()

try:
    req = urllib.request.Request(
        "http://127.0.0.1:8787/permission",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=58) as r:
        decision = json.load(r).get("decision", "pass")
except Exception:
    sys.exit(0)

if decision in ("allow", "deny"):
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PermissionRequest",
            "decision": {"behavior": decision},
        }
    }))
sys.exit(0)
